# Copy to .env locally. Never commit real credentials.
DEEPSEEK_API_KEY=replace-with-local-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DINGTALK_CLIENT_ID=replace-with-local-client-id
DINGTALK_CLIENT_SECRET=replace-with-local-client-secret
DINGTALK_ROBOT_CODE=replace-with-local-robot-code
DWS_PROFILE=replace-with-local-profile
MUMU_OPERATOR_USER_ID=replace-with-operator-user-id
MUMU_ALLOWED_USER_IDS=replace-with-operator-user-id
MUMU_SKILL_VERSION=v2
MUMU_RETRIEVAL_MODE=v2_live
MUMU_DOMAIN_ROUTING_ENABLED=true
MUMU_DOMAIN_ROUTING_MIN_CONFIDENCE=0.85
MUMU_INTERPRETATION_ENABLED=true
MUMU_CASE_WORKFLOW_ENABLED=false
MUMU_KNOWLEDGE_REFRESH_SECONDS=300
MUMU_FULL_SCAN_BATCH_SIZE=40
DEEPSEEK_TIMEOUT_SECONDS=45
MUMU_OWNER_USER_ID=
MUMU_OWNER_NAME=
MUMU_CASE_MAX_MESSAGES=500
MUMU_CASE_CARD_TEMPLATE_ID=replace-with-local-template-id
MUMU_STORE_GUIDE_WORKSPACE_ID=replace-with-local-workspace-id
